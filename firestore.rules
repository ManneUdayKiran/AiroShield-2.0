rules_version = '2';
// ============================================================
// AiroShield-AI — Cloud Firestore Security Rules
// Enforces Citizen Isolation & Community Abatement Pledges
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /citizens/{citizenId} {
      allow read, write: if request.auth != null && request.auth.uid == citizenId;
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == citizenId;
      }
    }
    match /community_pledges/{pledgeId} {
      allow read: if true;
      allow update: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
